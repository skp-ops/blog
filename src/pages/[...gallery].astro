---
import { getCollection } from 'astro:content'
import { base, defaultLocale, moreLocales } from '@/config'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
  type PathItem = {
    params: { gallery: string }
    props: { lang: string }
  }

  const paths: PathItem[] = []

  // Default locale
  paths.push({
    params: { gallery: 'gallery/' },
    props: { lang: defaultLocale },
  })

  // More locales
  moreLocales.forEach((lang: string) => {
    paths.push({
      params: { gallery: `${lang}/gallery/` },
      props: { lang },
    })
  })

  return paths
}

const { lang } = Astro.props
const photos = await getCollection('photos')

// Sort photos by date (newest first)
const sortedPhotos = photos.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
)

const PHOTOS_PER_PAGE = 24
const initialPhotos = sortedPhotos.slice(0, PHOTOS_PER_PAGE)

const toStr = (v: unknown) => (v === undefined || v === null ? '' : String(v))

// Get translation text
const translations = {
  en: {
    title: 'Gallery',
    totalPhotos: 'Total',
    photos: 'photos',
    loaded: 'Loaded',
    of: 'of',
    loading: 'Loading…',
    end: 'All photos loaded',
  },
  zh: {
    title: '画廊',
    totalPhotos: '共',
    photos: '张照片',
    loaded: '已加载',
    of: '/',
    loading: '加载中…',
    end: '已显示全部照片',
  },
  ja: {
    title: 'ギャラリー',
    totalPhotos: '合計',
    photos: '枚の写真',
    loaded: '読み込み済み',
    of: '/',
    loading: '読み込み中…',
    end: 'すべての写真を表示しました',
  },
}
const t = translations[lang as keyof typeof translations] || translations.en
---

<Layout>
  <div class="gallery-page">
    <h1 class="gallery-title">{t.title}</h1>
    <p class="gallery-desc">
      {t.totalPhotos} <span id="gallery-total">{sortedPhotos.length}</span> {t.photos}
    </p>
    <p class="gallery-progress" aria-live="polite">
      {t.loaded} <span id="gallery-loaded">{Math.min(PHOTOS_PER_PAGE, sortedPhotos.length)}</span> {t.of} <span>{sortedPhotos.length}</span>
    </p>

    <div
      class="gallery-grid"
      id="gallery-grid"
      data-total-photos={sortedPhotos.length}
      data-photos-per-page={PHOTOS_PER_PAGE}
      data-base={base}
    >
      {initialPhotos.map(photo => (
        <div
          class="gallery-item"
          data-photo-id={photo.id}
          data-aspect-ratio={(photo.data as any).width && (photo.data as any).height ? Number((photo.data as any).width) / Number((photo.data as any).height) : ''}
          style="--photo-span: 30"
        >
          <div class="gallery-card">
            <div class="gallery-image-wrapper">
              <img
                src={photo.data.thumbnail || photo.data.image}
                alt={photo.data.title}
                class="gallery-image"
                loading="lazy"
                decoding="async"
                fetchpriority={photo.id === sortedPhotos[0]?.id ? 'high' : 'auto'}
                data-full-image={photo.data.image}
                data-title={photo.data.title}
                data-location={toStr(photo.data.location)}
                data-description={toStr(photo.data.description)}
                data-date={new Date(photo.data.date).toISOString()}
                data-camera={toStr((photo.data as any).camera)}
                data-lens={toStr((photo.data as any).lens)}
                data-iso={toStr((photo.data as any).iso)}
                data-aperture={toStr((photo.data as any).aperture)}
                data-shutter={toStr((photo.data as any).shutter)}
                data-focal-length={toStr((photo.data as any).focalLength)}
                data-width={toStr((photo.data as any).width)}
                data-height={toStr((photo.data as any).height)}
              />
            </div>
          </div>
        </div>
      ))}
    </div>

    <div id="gallery-sentinel" class="gallery-sentinel" aria-hidden="true"></div>
    <div id="gallery-status" class="gallery-status" role="status" aria-live="polite"></div>
  </div>
</Layout>

<style>
  .gallery-page {
    width: 100%;
  }

  .gallery-title {
    font-size: 1.75rem;
    font-weight: bold;
    color: oklch(var(--un-preset-theme-colors-primary));
    margin-bottom: 0.75rem;
  }

  @media (min-width: 1024px) {
    .gallery-title {
      font-size: 2rem;
    }
  }

  .gallery-desc {
    font-size: 0.875rem;
    color: oklch(var(--un-preset-theme-colors-secondary));
    margin-bottom: 0.5rem;
  }

  .gallery-progress {
    font-size: 0.875rem;
    color: oklch(var(--un-preset-theme-colors-secondary));
    margin-bottom: 2.5rem;
  }

  .gallery-progress span {
    font-weight: 600;
    color: oklch(var(--un-preset-theme-colors-primary));
  }

  @media (min-width: 1024px) {
    .gallery-progress {
      margin-bottom: 3rem;
    }
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    grid-auto-rows: 8px;
    grid-auto-flow: dense;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  @media (min-width: 1440px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .gallery-item {
    grid-row-end: span var(--photo-span, 30);
    min-height: 0;
    content-visibility: auto;
    contain-intrinsic-size: auto 260px;
  }

  .gallery-card {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 1rem;
    backdrop-filter: blur(14px) saturate(120%);
    background: oklch(var(--un-preset-theme-colors-secondary) / 0.06);
    border: 1px solid oklch(var(--un-preset-theme-colors-secondary) / 0.12);
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
    box-shadow: 0 8px 30px oklch(var(--un-preset-theme-colors-secondary) / 0.12);
  }

  .gallery-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 40px oklch(var(--un-preset-theme-colors-secondary) / 0.18);
    border-color: oklch(var(--un-preset-theme-colors-secondary) / 0.18);
  }

  .gallery-image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 1rem;
    cursor: zoom-in;
    background: oklch(var(--un-preset-theme-colors-secondary) / 0.04);
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .gallery-card:hover .gallery-image {
    transform: scale(1.04);
  }

  .gallery-sentinel {
    height: 1px;
    margin-top: 1rem;
  }

  .gallery-status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2rem;
    padding: 1rem 0 2rem;
    color: oklch(var(--un-preset-theme-colors-secondary));
    font-size: 0.875rem;
  }

  .gallery-status.is-loading::before {
    content: '';
    width: 1em;
    height: 1em;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: gallery-spin 0.8s linear infinite;
  }

  @keyframes gallery-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script>
interface GalleryPhoto {
  id: string
  image: string
  thumbnail: string
  title: string
  location: string
  description: string
  date: string
  camera: string
  lens: string
  iso: string
  aperture: string
  shutter: string
  focalLength: string
  width?: string
  height?: string
}

interface GalleryApiResult {
  total?: number
  items?: GalleryPhoto[]
}

const ROW_HEIGHT = 8
let galleryCleanupFns: Array<() => void> = []

function toNumber(value: unknown): number {
  const number = Number(value)
  return Number.isFinite(number) && number > 0 ? number : 0
}

function getStatusText(lang: string): { loading: string, end: string } {
  if (lang.startsWith('zh')) {
    return { loading: '加载中…', end: '已显示全部照片' }
  }
  if (lang.startsWith('ja')) {
    return { loading: '読み込み中…', end: 'すべての写真を表示しました' }
  }
  return { loading: 'Loading…', end: 'All photos loaded' }
}

function setItemSpan(item: HTMLElement, img: HTMLImageElement) {
  const dataWidth = toNumber(img.dataset.width)
  const dataHeight = toNumber(img.dataset.height)
  const naturalWidth = img.naturalWidth || 0
  const naturalHeight = img.naturalHeight || 0
  const width = dataWidth || naturalWidth
  const height = dataHeight || naturalHeight
  const fallbackRatio = Number(item.dataset.aspectRatio) || 3 / 2
  const ratio = width && height ? width / height : fallbackRatio
  const columnWidth = item.getBoundingClientRect().width || 220
  const span = Math.max(8, Math.round((columnWidth / ratio) / ROW_HEIGHT))
  item.style.setProperty('--photo-span', String(span))
}

function createPhotoItem(photo: GalleryPhoto, templateItem: HTMLElement): HTMLElement {
  const item = templateItem.cloneNode(true) as HTMLElement
  item.setAttribute('data-photo-id', photo.id)
  item.dataset.aspectRatio = photo.width && photo.height
    ? String(toNumber(photo.width) / toNumber(photo.height))
    : templateItem.dataset.aspectRatio || ''

  const img = item.querySelector('img.gallery-image') as HTMLImageElement | null
  if (img) {
    img.src = String(photo.thumbnail || photo.image || '')
    img.alt = String(photo.title || '')
    img.loading = 'lazy'
    img.decoding = 'async'
    img.fetchPriority = 'auto'

    img.dataset.fullImage = String(photo.image || '')
    img.dataset.title = String(photo.title || '')
    img.dataset.location = String(photo.location || '')
    img.dataset.description = String(photo.description || '')
    img.dataset.date = String(photo.date || '')
    img.dataset.camera = String(photo.camera || '')
    img.dataset.lens = String(photo.lens || '')
    img.dataset.iso = String(photo.iso || '')
    img.dataset.aperture = String(photo.aperture || '')
    img.dataset.shutter = String(photo.shutter || '')
    img.dataset.focalLength = String(photo.focalLength || '')
    img.dataset.width = String(photo.width || '')
    img.dataset.height = String(photo.height || '')

    if (img.complete && img.naturalWidth > 0) {
      requestAnimationFrame(() => setItemSpan(item, img))
    }
    else {
      img.addEventListener('load', () => setItemSpan(item, img), { once: true })
    }
  }

  return item
}

function initGallery() {
  galleryCleanupFns.forEach(fn => fn())
  galleryCleanupFns = []

  const grid = document.getElementById('gallery-grid')
  const sentinel = document.getElementById('gallery-sentinel')
  const statusEl = document.getElementById('gallery-status')
  const loadedEl = document.getElementById('gallery-loaded')

  if (!grid || !sentinel || !statusEl || !loadedEl) {
    return
  }

  const gridEl = grid
  const sentinelEl = sentinel
  const statusElement = statusEl
  const loadedElement = loadedEl

  const templateItem = gridEl.querySelector('.gallery-item')
  if (!(templateItem instanceof HTMLElement)) {
    return
  }
  const template = templateItem

  const totalPhotos = Number.parseInt(gridEl.dataset.totalPhotos || '0', 10)
  const photosPerPage = Number.parseInt(gridEl.dataset.photosPerPage || '24', 10)
  const basePath = gridEl.dataset.base || ''
  const lang = document.documentElement.lang || 'en'
  const statusText = getStatusText(lang)

  let loadedCount = gridEl.querySelectorAll('.gallery-item').length
  let currentPage = Math.max(1, Math.ceil(loadedCount / photosPerPage))
  let loading = false
  let finished = loadedCount >= totalPhotos
  let disposed = false
  let observer: IntersectionObserver | null = null

  function updateProgress() {
    loadedElement.textContent = String(loadedCount)
  }

  function updateStatus(mode: 'idle' | 'loading' | 'end') {
    statusElement.classList.toggle('is-loading', mode === 'loading')
    if (mode === 'loading') {
      statusElement.textContent = statusText.loading
    }
    else if (mode === 'end') {
      statusElement.textContent = statusText.end
    }
    else {
      statusElement.textContent = ''
    }
  }

  function syncPageParam(page: number) {
    const url = new URL(window.location.href)
    if (page > 1) {
      url.searchParams.set('page', String(page))
    }
    else {
      url.searchParams.delete('page')
    }
    history.replaceState(history.state, '', url.toString())
  }

  async function fetchPhotos(offset: number, limit: number): Promise<GalleryPhoto[]> {
    const response = await fetch(`${basePath}/api/photos.json?offset=${offset}&limit=${limit}`)
    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`)
    }
    const data = await response.json() as GalleryApiResult
    return Array.isArray(data.items) ? data.items : []
  }

  function appendPhotos(items: GalleryPhoto[]) {
    if (items.length === 0) {
      return
    }

    const fragment = document.createDocumentFragment()
    items.forEach((photo) => {
      fragment.appendChild(createPhotoItem(photo, template))
    })
    gridEl.appendChild(fragment)
    loadedCount += items.length
    updateProgress()
  }

  async function loadNextPage() {
    if (disposed || loading || finished || loadedCount >= totalPhotos) {
      return
    }

    loading = true
    updateStatus('loading')

    try {
      const items = await fetchPhotos(loadedCount, photosPerPage)
      appendPhotos(items)

      if (items.length < photosPerPage || loadedCount >= totalPhotos) {
        finished = true
      }

      currentPage = Math.ceil(loadedCount / photosPerPage)
      syncPageParam(currentPage)
      updateStatus(finished ? 'end' : 'idle')
    }
    catch (error) {
      console.error('Failed to load gallery photos:', error)
      updateStatus('idle')
      statusElement.textContent = lang.startsWith('zh')
        ? '加载失败，请重试'
        : lang.startsWith('ja')
          ? '読み込みに失敗しました'
          : 'Failed to load. Please try again.'
    }
    finally {
      loading = false
      if (!finished && loadedCount < totalPhotos) {
        requestAnimationFrame(loadIfSentinelVisible)
      }
    }
  }

  function loadIfSentinelVisible() {
    if (disposed || loading || finished || loadedCount >= totalPhotos) {
      return
    }

    const rect = sentinelEl.getBoundingClientRect()
    if (rect.top < window.innerHeight + 800) {
      loadNextPage()
    }
  }

  async function restorePage(page: number) {
    const targetPage = Math.min(page, Math.ceil(totalPhotos / photosPerPage))
    const targetCount = targetPage * photosPerPage
    const missing = targetCount - loadedCount
    if (missing <= 0 || finished) {
      return
    }

    loading = true
    updateStatus('loading')
    try {
      const items = await fetchPhotos(loadedCount, Math.min(missing, totalPhotos - loadedCount))
      appendPhotos(items)
      loadedCount = gridEl.querySelectorAll('.gallery-item').length
      finished = loadedCount >= totalPhotos
      currentPage = Math.ceil(loadedCount / photosPerPage)
      syncPageParam(currentPage)
      updateStatus(finished ? 'end' : 'idle')
    }
    catch (error) {
      console.error('Failed to restore gallery page:', error)
      updateStatus('idle')
    }
    finally {
      loading = false
    }
  }

  function layoutAllItems() {
    gridEl.querySelectorAll('.gallery-item').forEach((item) => {
      const img = item.querySelector('img.gallery-image') as HTMLImageElement | null
      if (img && (img.naturalWidth > 0 || img.dataset.width)) {
        setItemSpan(item as HTMLElement, img)
      }
    })
  }

  if (typeof IntersectionObserver !== 'undefined') {
    observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          loadNextPage()
        }
      })
    }, { rootMargin: '800px 0px' })
    observer.observe(sentinelEl)
  }
  else {
    const onScroll = () => loadIfSentinelVisible()
    window.addEventListener('scroll', onScroll, { passive: true })
    galleryCleanupFns.push(() => window.removeEventListener('scroll', onScroll))
  }

  let resizeTimer: number | undefined
  const onResize = () => {
    if (resizeTimer !== undefined) {
      window.clearTimeout(resizeTimer)
    }
    resizeTimer = window.setTimeout(layoutAllItems, 120)
  }
  window.addEventListener('resize', onResize, { passive: true })

  galleryCleanupFns.push(() => {
    disposed = true
    observer?.disconnect()
    window.removeEventListener('resize', onResize)
    if (resizeTimer !== undefined) {
      window.clearTimeout(resizeTimer)
    }
  })

  const initialPage = Number.parseInt(new URLSearchParams(window.location.search).get('page') || '1', 10)
  if (Number.isFinite(initialPage) && initialPage > 1) {
    restorePage(initialPage)
  }
  else {
    updateStatus(finished ? 'end' : 'idle')
    loadIfSentinelVisible()
  }

  requestAnimationFrame(layoutAllItems)
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initGallery)
}
else {
  initGallery()
}

document.addEventListener('astro:after-swap', initGallery)
</script>
