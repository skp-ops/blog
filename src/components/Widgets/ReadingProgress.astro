<div id="reading-progress" class="reading-progress" aria-hidden="true"></div>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 999;
    width: 0;
    height: 3px;
    background: oklch(var(--un-preset-theme-colors-primary));
    box-shadow: 0 0 8px oklch(var(--un-preset-theme-colors-primary) / 0.4);
    transition: width 80ms linear;
    pointer-events: none;
  }
</style>

<script>
let cleanupProgress: (() => void) | null = null

function updateReadingProgress() {
  const bar = document.getElementById('reading-progress')
  if (!bar)
    return

  const documentElement = document.documentElement
  const maxScroll = documentElement.scrollHeight - window.innerHeight
  const scrolled = window.scrollY || documentElement.scrollTop
  const progress = maxScroll > 0
    ? Math.min(100, Math.max(0, (scrolled / maxScroll) * 100))
    : 0

  bar.style.width = `${progress}%`
}

function initReadingProgress() {
  cleanupProgress?.()
  cleanupProgress = null

  updateReadingProgress()

  const onScroll = () => updateReadingProgress()
  const onResize = () => updateReadingProgress()
  window.addEventListener('scroll', onScroll, { passive: true })
  window.addEventListener('resize', onResize, { passive: true })

  cleanupProgress = () => {
    window.removeEventListener('scroll', onScroll)
    window.removeEventListener('resize', onResize)
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initReadingProgress)
}
else {
  initReadingProgress()
}

document.addEventListener('astro:page-load', initReadingProgress)
</script>
