---
import { base, defaultLocale } from '@/config'
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
---

<div
  class="search-container"
  data-lang={currentLang}
  data-default-lang={defaultLocale}
  data-base={base}
>
  <div class="search-box">
    <svg
      class="search-icon"
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>
    <input
      type="text"
      id="search-input"
      class="search-input"
      placeholder={currentUI.search || 'Search...'}
      aria-label="Search posts"
    />
    <kbd id="search-shortcut" class="search-shortcut" aria-hidden="true">⌘K</kbd>
    <button
      id="search-clear"
      class="search-clear"
      aria-label="Clear search"
      style="display: none;"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div id="search-results" class="search-results" style="display: none;">
    <div id="search-results-content"></div>
  </div>
</div>

<script>
 interface Post {
   title: string
   slug: string
   lang: string
   description?: string
   date: Date
   tags?: string[]
   content?: string
 }

 let allPosts: Post[] | null = null
 let postsPromise: Promise<Post[]> | null = null
 let searchContainer: HTMLElement
 let searchInput: HTMLInputElement
 let searchClear: HTMLButtonElement
 let searchShortcut: HTMLElement
 let searchResults: HTMLElement
 let searchResultsContent: HTMLElement
 let currentLang: string
 let defaultLang: string
 let basePath: string

 let searchTimer: number | undefined
 let selectedIndex = -1
 let resultItems: HTMLAnchorElement[] = []
 const cleanupFns: Array<() => void> = []
 const SEARCH_HISTORY_KEY = 'blog-search-history'
 const MAX_RECENT_SEARCHES = 5

 function getSearchCopy() {
   if (currentLang === 'zh') {
     return {
       loading: '正在搜索…',
       loadError: '搜索索引加载失败，请稍后重试。',
       noResults: (query: string) => `没有找到与“${query}”相关的内容`,
       moreResults: (count: number) => `另有 ${count} 条结果`,
     }
   }
   if (currentLang === 'ja') {
     return {
       loading: '検索中…',
       loadError: '検索インデックスを読み込めませんでした。',
       noResults: (query: string) => `「${query}」に一致する記事はありません`,
       moreResults: (count: number) => `他に ${count} 件あります`,
     }
   }
   return {
     loading: 'Searching…',
     loadError: 'Search index could not be loaded.',
     noResults: (query: string) => `No results found for "${query}"`,
     moreResults: (count: number) => `+${count} more results`,
   }
 }

 function getPostsForCurrentLang() {
   return (allPosts ?? []).filter(post => post.lang === currentLang || post.lang === '')
 }

 async function loadPosts() {
   if (allPosts)
     return allPosts
   if (postsPromise)
     return postsPromise

   postsPromise = fetch(`${basePath}/api/search.json`)
     .then((response) => {
       if (!response.ok)
         throw new Error(`HTTP ${response.status}`)
       return response.json()
     })
     .then((payload) => {
       if (!Array.isArray(payload))
         throw new TypeError('Invalid search index')
       allPosts = payload
       return allPosts
     })
     .catch((error) => {
       postsPromise = null
       throw error
     })

   return postsPromise
 }

 function cancelPendingSearch() {
   if (searchTimer !== undefined) {
     window.clearTimeout(searchTimer)
     searchTimer = undefined
   }
 }

 function getPostHref(post: Post): string {
   const prefix = currentLang === defaultLang ? '' : `/${currentLang}`
   return `${basePath}${prefix}${post.slug}`
 }

 function getRecentSearches(): string[] {
   try {
     const raw = localStorage.getItem(SEARCH_HISTORY_KEY)
     const parsed = raw ? JSON.parse(raw) : []
     return Array.isArray(parsed)
       ? parsed.filter((item): item is string => typeof item === 'string').slice(0, MAX_RECENT_SEARCHES)
       : []
   }
   catch {
     return []
   }
 }

 function saveRecentSearch(query: string) {
   const normalized = query.trim()
   if (normalized.length < 2) {
     return
   }

   try {
     const next = [normalized, ...getRecentSearches().filter(item => item !== normalized)]
       .slice(0, MAX_RECENT_SEARCHES)
     localStorage.setItem(SEARCH_HISTORY_KEY, JSON.stringify(next))
   }
   catch {
     // localStorage can be unavailable in private/security-restricted contexts.
   }
 }

 function showRecentSearches() {
   const recentSearches = getRecentSearches()
   if (recentSearches.length === 0) {
     hideResults()
     return
   }

   searchResultsContent.replaceChildren()

   const header = document.createElement('div')
   header.className = 'search-recent-header'
   header.textContent = document.documentElement.lang?.startsWith('zh')
     ? '最近搜索'
     : document.documentElement.lang?.startsWith('ja')
       ? '最近の検索'
       : 'Recent searches'

   const list = document.createElement('div')
   list.className = 'search-recent-list'

   recentSearches.forEach((query) => {
     const button = document.createElement('button')
     button.type = 'button'
     button.className = 'search-recent-item'
     button.textContent = query
     button.addEventListener('click', () => {
       searchInput.value = query
       searchClear.style.display = 'flex'
       searchShortcut.hidden = true
       void executeSearch(query)
       saveRecentSearch(query)
       searchInput.focus()
     })
     list.appendChild(button)
   })

   searchResultsContent.append(header, list)
   searchResults.style.display = 'block'
 }

 function initSearch() {
   searchContainer = document.querySelector('.search-container') as HTMLElement
   if (!searchContainer)
     return

   searchInput = document.getElementById('search-input') as HTMLInputElement
   searchClear = document.getElementById('search-clear') as HTMLButtonElement
   searchShortcut = document.getElementById('search-shortcut') as HTMLElement
   searchResults = document.getElementById('search-results') as HTMLElement
   searchResultsContent = document.getElementById('search-results-content') as HTMLElement

   // Language and base path are provided by the server-rendered component.
   currentLang = searchContainer.dataset.lang || 'zh'
   defaultLang = searchContainer.dataset.defaultLang || 'zh'
   basePath = searchContainer.dataset.base || ''

   // Remove listeners from any previous page/view-transition initialization.
   cleanupFns.forEach(fn => fn())
   cleanupFns.length = 0
   cancelPendingSearch()
   selectedIndex = -1
   resultItems = []
   searchShortcut.textContent = /Mac|iPhone|iPad/.test(navigator.userAgent) ? '⌘K' : 'Ctrl K'
   searchShortcut.hidden = Boolean(searchInput.value)

   // Event listeners
   const onInput = () => handleSearch()
   const onFocus = () => handleSearch()
   const onKeydown = (event: KeyboardEvent) => handleKeydown(event)
   const onClear = () => clearSearch()

   searchInput.addEventListener('input', onInput)
   searchInput.addEventListener('focus', onFocus)
   searchInput.addEventListener('keydown', onKeydown)
   searchClear.addEventListener('click', onClear)
   cleanupFns.push(() => searchInput.removeEventListener('input', onInput))
   cleanupFns.push(() => searchInput.removeEventListener('focus', onFocus))
   cleanupFns.push(() => searchInput.removeEventListener('keydown', onKeydown))
   cleanupFns.push(() => searchClear.removeEventListener('click', onClear))

   const onGlobalKeydown = (event: KeyboardEvent) => {
     const target = event.target as HTMLElement | null
     const isEditing = Boolean(target?.matches('input, textarea, select, [contenteditable="true"]'))

     if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
       event.preventDefault()
       searchInput.focus()
       searchInput.select()
       handleSearch()
       return
     }

     if (event.key === '/' && !isEditing && !event.metaKey && !event.ctrlKey && !event.altKey) {
       event.preventDefault()
       searchInput.focus()
     }
   }
   document.addEventListener('keydown', onGlobalKeydown)
   cleanupFns.push(() => document.removeEventListener('keydown', onGlobalKeydown))

   // Close search results when clicking outside
   const onDocumentClick = (e: MouseEvent) => {
     const target = e.target as HTMLElement
     if (!searchContainer.contains(target)) {
       hideResults()
     }
   }
   document.addEventListener('click', onDocumentClick)
   cleanupFns.push(() => document.removeEventListener('click', onDocumentClick))

   // Close search results when scrolling on mobile
   let scrollTimeout: number | undefined
   const onScroll = () => {
     if (scrollTimeout !== undefined) {
       window.clearTimeout(scrollTimeout)
     }
     scrollTimeout = window.setTimeout(() => {
       if (window.innerWidth < 768) {
         hideResults()
       }
     }, 100)
   }
   window.addEventListener('scroll', onScroll, { passive: true })
   cleanupFns.push(() => window.removeEventListener('scroll', onScroll))

   // Restore a query from the URL, if present.
   const initialQuery = new URLSearchParams(window.location.search).get('q')?.trim() || ''
   if (initialQuery.length >= 2) {
     searchInput.value = initialQuery
     searchClear.style.display = 'flex'
     searchShortcut.hidden = true
     void executeSearch(initialQuery)
   }
 }

 function handleSearch() {
   const query = searchInput.value.trim()

   // Show/hide clear button
   searchClear.style.display = query ? 'flex' : 'none'
   searchShortcut.hidden = Boolean(query)

   cancelPendingSearch()

   if (!query) {
     selectedIndex = -1
     showRecentSearches()
     return
   }

   if (query.length < 2) {
     hideResults()
     return
   }

   searchTimer = window.setTimeout(() => void executeSearch(query), 180)
 }

 async function executeSearch(query: string) {
   const normalized = query.trim().toLowerCase()
   if (normalized.length < 2) {
     return
   }

   if (!allPosts)
     displayLoading()

   try {
     await loadPosts()
     if (searchInput.value.trim() !== query)
       return

     const results = getPostsForCurrentLang().filter((post) => {
       const titleMatch = post.title.toLowerCase().includes(normalized)
       const descMatch = post.description?.toLowerCase().includes(normalized) || false
       const tagsMatch = post.tags?.some(tag => tag.toLowerCase().includes(normalized)) || false
       const contentMatch = post.content?.toLowerCase().includes(normalized) || false
       return titleMatch || descMatch || tagsMatch || contentMatch
     })

     displayResults(results, query)
     syncQueryParam(query)
   }
   catch (error) {
     console.error('Failed to fetch posts data:', error)
     displayLoadError()
   }
 }

 function displayLoading() {
   searchResultsContent.replaceChildren()
   const loading = document.createElement('div')
   loading.className = 'search-no-results'
   const text = document.createElement('p')
   text.textContent = getSearchCopy().loading
   loading.appendChild(text)
   searchResultsContent.appendChild(loading)
   searchResults.style.display = 'block'
 }

 function displayLoadError() {
   searchResultsContent.replaceChildren()
   const error = document.createElement('div')
   error.className = 'search-no-results'
   const text = document.createElement('p')
   text.textContent = getSearchCopy().loadError
   error.appendChild(text)
   searchResultsContent.appendChild(error)
   searchResults.style.display = 'block'
 }

 function createSnippet(text: string, query: string, radius = 80): string {
   const source = text || ''
   const index = source.toLowerCase().indexOf(query.toLowerCase())
   if (index === -1) {
     return source.slice(0, 160)
   }

   const start = Math.max(0, index - radius)
   const end = Math.min(source.length, index + query.length + radius)
   const prefix = start > 0 ? '…' : ''
   const suffix = end < source.length ? '…' : ''
   return `${prefix}${source.slice(start, end)}${suffix}`
 }

 function formatDate(value: Date | string): string {
   const date = new Date(value)
   if (Number.isNaN(date.getTime())) {
     return ''
   }
   return date.toLocaleDateString(undefined, {
     year: 'numeric',
     month: 'short',
     day: 'numeric',
   })
 }

 function displayResults(results: Post[], query: string) {
   selectedIndex = -1
   resultItems = []
   searchResultsContent.replaceChildren()

   if (results.length === 0) {
     const empty = document.createElement('div')
     empty.className = 'search-no-results'
     const text = document.createElement('p')
     text.textContent = getSearchCopy().noResults(query)
     empty.appendChild(text)
     searchResultsContent.appendChild(empty)
   }
   else {
     const fragment = document.createDocumentFragment()
     results.slice(0, 10).forEach((post) => {
       const item = document.createElement('a')
       item.href = getPostHref(post)
       item.className = 'search-result-item'
       item.setAttribute('data-search-result', '')

       const title = document.createElement('div')
       title.className = 'search-result-title'
       title.innerHTML = highlightText(post.title, query)

       item.appendChild(title)

       if (post.description) {
         const description = document.createElement('div')
         description.className = 'search-result-desc'
         description.innerHTML = highlightText(post.description, query)
         item.appendChild(description)
       }
       else if (post.content) {
         const content = document.createElement('div')
         content.className = 'search-result-desc'
         content.innerHTML = highlightText(createSnippet(post.content, query), query)
         item.appendChild(content)
       }

       const meta = document.createElement('div')
       meta.className = 'search-result-meta'
       const date = document.createElement('span')
       date.className = 'search-result-date'
       date.textContent = formatDate(post.date)
       meta.appendChild(date)

       if (post.tags && post.tags.length > 0) {
         const tags = document.createElement('span')
         tags.className = 'search-result-tags'
         post.tags.slice(0, 3).forEach((tag) => {
           const tagElement = document.createElement('span')
           tagElement.className = 'tag'
           tagElement.textContent = tag
           tags.appendChild(tagElement)
         })
         meta.appendChild(tags)
       }
       item.appendChild(meta)

       item.addEventListener('mouseenter', () => {
         const index = resultItems.indexOf(item)
         if (index !== -1) {
           setSelectedIndex(index)
         }
       })
       item.addEventListener('click', () => saveRecentSearch(query))

       fragment.appendChild(item)
       resultItems.push(item)
     })

     searchResultsContent.appendChild(fragment)

     if (results.length > 10) {
       const more = document.createElement('div')
       more.className = 'search-more-results'
       const text = document.createElement('p')
       text.textContent = getSearchCopy().moreResults(results.length - 10)
       more.appendChild(text)
       searchResultsContent.appendChild(more)
     }
   }

   searchResults.style.display = 'block'
 }

 function setSelectedIndex(index: number) {
   if (resultItems.length === 0) {
     selectedIndex = -1
     return
   }

   selectedIndex = (index + resultItems.length) % resultItems.length
   resultItems.forEach((item, itemIndex) => {
     item.classList.toggle('search-result-selected', itemIndex === selectedIndex)
     if (itemIndex === selectedIndex) {
       item.scrollIntoView({ block: 'nearest' })
     }
   })
 }

 function handleKeydown(event: KeyboardEvent) {
   if (event.key === 'Escape') {
     hideResults()
     searchInput.blur()
     return
   }

   if (event.key === 'ArrowDown') {
     event.preventDefault()
     if (resultItems.length > 0) {
       setSelectedIndex(selectedIndex + 1)
     }
     return
   }

   if (event.key === 'ArrowUp') {
     event.preventDefault()
     if (resultItems.length > 0) {
       setSelectedIndex(selectedIndex - 1)
     }
     return
   }

   if (event.key === 'Enter') {
     const query = searchInput.value.trim()
     if (query.length < 2) {
       return
     }

     if (selectedIndex >= 0 && resultItems[selectedIndex]) {
       event.preventDefault()
       saveRecentSearch(query)
       resultItems[selectedIndex].click()
     }
     else {
       saveRecentSearch(query)
     }
   }
 }

 function hideResults() {
   searchResults.style.display = 'none'
   selectedIndex = -1
 }

 function clearSearch() {
   cancelPendingSearch()
   searchInput.value = ''
   searchClear.style.display = 'none'
   searchShortcut.hidden = false
   hideResults()
   syncQueryParam('')
   searchInput.focus()
 }

 function syncQueryParam(query: string) {
   const url = new URL(window.location.href)
   if (query) {
     url.searchParams.set('q', query)
   }
   else {
     url.searchParams.delete('q')
   }
   history.replaceState(history.state, '', url.toString())
 }

 function highlightText(text: string, query: string): string {
   const regex = new RegExp(`(${escapeRegex(query)})`, 'gi')
   return escapeHtml(text).replace(regex, '<mark>$1</mark>')
 }

 function escapeHtml(text: string): string {
   const div = document.createElement('div')
   div.textContent = text
   return div.innerHTML
 }

 function escapeRegex(text: string): string {
   return text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
 }

 // Initialize on page load
 if (document.readyState === 'loading') {
   document.addEventListener('DOMContentLoaded', initSearch)
 }
 else {
   initSearch()
 }

 // Re-initialize after view transitions
 document.addEventListener('astro:after-swap', initSearch)
</script>
